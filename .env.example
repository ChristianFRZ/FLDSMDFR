# 02-separacion: cada servicio recibe su propia URL de base desde docker-compose.yml.
# Aquí solo va lo que comparten o lo que conviene cambiar.

# Secreto con el que users-playlists firma los JWT y los otros dos servicios los validan.
FLDSMDFR_JWT_SECRET=cambia-este-secreto-en-produccion
FLDSMDFR_COOKIE_SECURE=false

# Usuarios demo (los crea la semilla de users-playlists).
FLDSMDFR_ADMIN_EMAIL=admin@fldsmdfr.mx
FLDSMDFR_ADMIN_PASSWORD=admin12345
FLDSMDFR_LISTENER_EMAIL=oyente@fldsmdfr.mx
FLDSMDFR_LISTENER_PASSWORD=oyente12345
