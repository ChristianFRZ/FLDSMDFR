# Copia este archivo a .env y completa los valores.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://meloxo:CAMBIA_ESTO@localhost:5433/meloxo
JWT_SECRET=
# Credencial privada compartida por app y catálogo. Genera otra con openssl rand -hex 32.
CATALOG_INTERNAL_TOKEN=
CATALOG_TIMEOUT_SECONDS=1.5
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Clave de las cuentas ficticias de la semilla. Vacía: se genera una al azar en cada corrida.
DEMO_PASSWORD=
JAMENDO_CLIENT_ID=
# proxy o redirect
JAMENDO_AUDIO_MODE=proxy
# Una clave hexadecimal diferente por base (openssl rand -hex 32).
USERS_DB_PASSWORD=
CATALOG_DB_PASSWORD=
PLAYBACK_DB_PASSWORD=
