# Copia este archivo a .env y completa los valores.
POSTGRES_PASSWORD=
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Clave de las cuentas ficticias de la semilla. Vacía: se genera una al azar en cada corrida.
DEMO_PASSWORD=
JAMENDO_CLIENT_ID=
# proxy o redirect
JAMENDO_AUDIO_MODE=proxy
# Claves de los roles de cada servicio en PostgreSQL (las usa infra/postgres/init.sh).
USERS_DB_PASSWORD=
CATALOG_DB_PASSWORD=
PLAYBACKS_DB_PASSWORD=
# Redis (cola de reproducciones y revocación de sesiones). Compose ya fija esta dirección; vacía desactiva Redis.
# REDIS_URL=redis://redis:6379/0
